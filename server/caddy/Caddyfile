# Caddy: the front door for Jellyfin and Seerr from the internet.
# It answers https://media.jevans.cloud and https://requests.jevans.cloud, gets and renews the HTTPS certificate on its own,
# and passes each visitor through to the right app. Nothing else on the server is reachable this way.
# home.jevans.cloud (the dashboard) and vault.jevans.cloud (the password safe) are the exceptions: they only answer inside your home.

# A "please don't list me" sign for search engines like Google and Bing.
# Jellyfin and Seerr are sign-in pages for you and your friends, not something strangers should find in search results.
# robots.txt asks crawlers not to look around, and the X-Robots-Tag header tells them not to list any page they do see.
(no_search_engines) {
	header X-Robots-Tag "noindex, nofollow"
	respond /robots.txt <<TXT
		User-agent: *
		Disallow: /
		TXT 200
}

media.jevans.cloud {
	import no_search_engines

	# Squeeze the web pages and API replies (video is already compressed, so it is left alone).
	encode zstd gzip

	reverse_proxy jellyfin:8096
}

# Seerr: where people ask for movies and shows. They sign in with their Jellyfin account.
requests.jevans.cloud {
	import no_search_engines

	encode zstd gzip

	reverse_proxy seerr:5055
}

# The dashboard, home-only. Caddy still gets it a real HTTPS certificate,
# but anyone not on your home network is turned away before they see anything.
home.jevans.cloud {
	@outside not remote_ip private_ranges
	abort @outside

	reverse_proxy homepage:3000
}

# Vaultwarden, the password safe, home-only like the dashboard. The Bitwarden apps need the real HTTPS
# certificate Caddy gets here. Live updates between your devices ride the same connection, nothing extra needed.
vault.jevans.cloud {
	@outside not remote_ip private_ranges
	abort @outside

	encode zstd gzip

	# Tell Vaultwarden the visitor's real address, so its log of failed logins names the right device.
	reverse_proxy vaultwarden:80 {
		header_up X-Real-IP {remote_host}
	}
}
