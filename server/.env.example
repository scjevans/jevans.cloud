# Copy this file to .env (cp .env.example .env) and fill it in.
# .env holds secrets: it is ignored by git, never commit it.

# ---- You, on the server ----
# Run `id` on the server: use the numbers after uid= and gid=.
PUID=1000
PGID=1000
# Your time zone, from https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/New_York

# ---- Folders on the server ----
# App settings live here (one subfolder per app). Back this up.
CONFIG_DIR=/opt/media/config
# Downloads AND your library live here, on the same drive, so files move instantly.
DATA_DIR=/data

# ---- VPN (from your VPN provider's WireGuard config) ----
# Provider name as Gluetun spells it, e.g. mullvad, protonvpn, airvpn, ivpn, nordvpn, surfshark, windscribe.
# Full list: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
VPN_SERVICE_PROVIDER=mullvad
# The "PrivateKey" line of your WireGuard config file.
WIREGUARD_PRIVATE_KEY=
# The "Address" line of your WireGuard config file, e.g. 10.64.222.21/32
WIREGUARD_ADDRESSES=
# Which country's servers to use, e.g. Netherlands, or several: Netherlands,Sweden
SERVER_COUNTRIES=Netherlands

# ---- Your home network ----
# So you can open qBittorrent and Prowlarr from other devices at home.
# Most home routers use 192.168.1.0/24 or 192.168.0.0/24 (check your server's IP: the first three numbers).
LAN_SUBNET=192.168.1.0/24
# The server's own address on your home network. The dashboard uses it for its links.
SERVER_IP=192.168.1.95

# ---- Jellyfin ----
# The address people use to reach Jellyfin.
JELLYFIN_URL=https://media.jevans.cloud

# ---- JellyDash (watch statistics) ----
# README.md step 11 walks through these.
# A Jellyfin API key: Jellyfin > Dashboard > API Keys > +.
JELLYDASH_JELLYFIN_API_KEY=
# The username and password for JellyDash's own login (8+ characters). Only used the first time it starts.
JELLYDASH_ADMIN_USER=
JELLYDASH_ADMIN_PASSWORD=
# Optional. Seerr's API key (Seerr > Settings > General) to see requests in JellyDash.
JELLYDASH_SEERR_API_KEY=
# Optional. An ntfy.sh topic for "someone started watching" alerts. Use a different one from Uptime Kuma's.
JELLYDASH_NTFY_TOPIC=

# ---- Beszel (server health charts and alerts) ----
# Both come from the hub's "Add System" box. README.md step 16c walks through it.
# The "KEY" line: the hub's public key, starting ssh-ed25519. Keep the single quotes around it.
BESZEL_AGENT_KEY=
# The "TOKEN" line.
BESZEL_AGENT_TOKEN=
# The read-only Beszel login the daily report uses (README.md step 23). Not your own login.
BESZEL_REPORT_EMAIL=
BESZEL_REPORT_PASSWORD=
# Where the private reports repo is cloned on the server. Blank means ~/server-reports.
REPORTS_REPO=

# ---- Uptime Kuma (alerts) ----
# The Push URL of the "Media drive plugged in" monitor. README.md step 22e.
MEDIA_DRIVE_PUSH_URL=

# ---- Vaultwarden (password safe) ----
# Leave false. README.md step 17 flips it to true just long enough to make your account.
VAULTWARDEN_SIGNUPS_ALLOWED=false
# The scrambled password for https://vault.jevans.cloud/admin. README.md step 17 has the command that makes it.
# Keep the single quotes around it: they stop Docker reading the $ signs inside as settings.
# Blank means the admin page is switched off: the safest choice once your account exists.
VAULTWARDEN_ADMIN_TOKEN=

# ---- SyncTube (watch parties) ----
# The scrambled shared password for https://watch.jevans.cloud. README.md step 25 has the command that makes it.
# Keep the single quotes around it: they stop Docker reading the $ signs inside as settings.
# Caddy won't start while this is blank, so do step 25 in order.
SYNCTUBE_PASSWORD_HASH=

# ---- Speedtest Tracker (home internet speed) ----
# The key it scrambles its saved settings with, starting base64:. README.md step 18a has the command that makes it.
SPEEDTEST_APP_KEY=
# An API token from Speedtest Tracker, so the dashboard tile can show the latest result. README.md step 18c.
SPEEDTEST_API_TOKEN=
# Optional: the ID of the test server to always use (blank = nearest each time). README.md step 18f.
SPEEDTEST_SERVERS=
